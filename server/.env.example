# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local:   postgresql://postgres:devpassword@localhost:5432/crocheta
# Hosted:  postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/crocheta

# The password gate (HTTP Basic Auth). Leave both unset locally to turn the
# gate off while developing. In production the server refuses to start without them.
APP_USER=
APP_PASSWORD=

# Only needed when the client runs on a different origin (Vite dev server).
CORS_ORIGINS=http://localhost:5173

NODE_ENV=development

# Do NOT set PORT. The host sets it.
